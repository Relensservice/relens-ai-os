rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function staff() { return role() in ['owner','admin','manager','staff','optician']; }
    function manager() { return role() in ['owner','admin','manager']; }
    function ownerAdmin() { return role() in ['owner','admin']; }
    function optician() { return role() in ['owner','admin','optician']; }

    // Staff-only business data. No public client access.
    match /products/{id} {
      allow read: if staff();
      allow create, update: if manager() || (role() == 'staff' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','updatedAt']));
      allow delete: if manager();
    }
    match /sales/{id} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow update, delete: if manager();
    }
    match /orders/{id} {
      allow read: if staff();
      allow create, update: if staff();
      allow delete: if manager();
    }
    match /customers/{id} {
      allow read: if staff();
      allow create, update: if staff();
      allow delete: if manager();
    }
    // Prescription data is separated from general customer records.
    match /prescriptions/{id} {
      allow read, write: if optician();
    }
    match /stockMovements/{id} {
      allow read: if staff();
      allow create: if manager() || role() == 'staff';
      allow update, delete: if manager();
    }
    match /suppliers/{id} {
      allow read: if manager();
      allow write: if manager();
    }
    match /expenses/{id} {
      allow read, write: if manager();
    }
    match /settings/{id} {
      allow read: if staff();
      allow write: if ownerAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}